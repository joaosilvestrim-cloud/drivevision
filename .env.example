# Runtime only. Never prefix credentials with VITE_ or NEXT_PUBLIC_.
DRIVEVISION_DB_HOST=copy-the-transaction-pooler-host
DRIVEVISION_DB_PORT=6543
DRIVEVISION_DB_DATABASE=postgres
DRIVEVISION_DB_USER=drivevision_app.PROJECT_REF
DRIVEVISION_DB_PASSWORD=generated-runtime-role-password
# Alternative: DRIVEVISION_DATABASE_URL=postgresql://drivevision_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# DRIVEVISION_APP_ORIGIN=https://your-app.vercel.app
# DRIVEVISION_ALLOW_REGISTRATION=false
# Optional custom database CA; default is the bundled Supabase CA.
# DRIVEVISION_DB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Administrative credentials are used ONLY by the one-time setup script.
# DRIVEVISION_DB_ADMIN_USER=postgres
# DRIVEVISION_DB_ADMIN_PASSWORD=never-deploy-this-value
