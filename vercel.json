{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist-preview",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "crons": [{ "path": "/api/cron/sources", "schedule": "* * * * *" }],
  "functions": {
    "api/**/*.ts": { "includeFiles": "server/certs/**", "maxDuration": 120 }
  }
}
